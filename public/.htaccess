# Apache/LiteSpeed rules for cPanel.
# Lives in public/ so `next build` copies it into out/ automatically.
#
# ⚠ cPanel File Manager HIDES dotfiles until Settings → Show Hidden Files is
# enabled. A missing .htaccess is a silent failure: no HTTPS redirect, no 404
# page, no caching. Verify it after every upload.

# --- Directory listing ------------------------------------------------------
# Without this, cPanel's autoindex serves a browsable "Index of /images/" for
# every directory with no index.html. Verified live on 2026-08-25: /images/,
# /images/brand/, /images/brands/, /images/office/, /api/ and /_next/ were all
# listing their contents publicly.
Options -Indexes

# --- Force HTTPS ------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Custom error page ------------------------------------------------------
ErrorDocument 404 /404.html

# --- Caching ----------------------------------------------------------------
# Next.js content-hashes asset filenames, so they can be cached indefinitely.
# HTML must NOT be cached, or a deploy appears to do nothing for returning
# visitors.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Baseline security headers
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"

  # The 301 only fires after a plaintext request has already left the browser.
  # ⚠ Cached for the full max-age: if HTTPS breaks, the site goes unreachable.
  # includeSubDomains omitted until AutoSSL is confirmed on every subdomain.
  Header always set Strict-Transport-Security "max-age=31536000"

  # 'unsafe-inline' is required by the Next.js bootstrap and the JSON-LD tag.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

# --- Protect the mail config, belt and braces -------------------------------
# The real protection is that it lives OUTSIDE public_html. This is a backstop
# in case it is ever misplaced.
<FilesMatch "config\.php$">
  Require all denied
</FilesMatch>

# Block dotfiles from being served
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Block PHP's own error log ----------------------------------------------
# lsphp writes error_log into the script's own directory when php.ini sets no
# path — public_html/api/error_log, web-readable, leaking SMTP host and paths.
<FilesMatch "^(error_log|php_errorlog)$">
  Require all denied
</FilesMatch>

# --- Next.js prefetch payloads ----------------------------------------------
# trailingSlash + output:export makes Next WRITE out/about/__next.about/__PAGE__.txt
# but REQUEST /about/__next.about.__PAGE__.txt — dots where the path has slashes.
# Every <Link> prefetch 404s without this, so client navigation falls back to
# full page loads.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*)__next\.([^./]+)\.__PAGE__\.txt$ $1__next.$2/__PAGE__.txt [L]
</IfModule>

# --- Block direct access to the mail library ---------------------------------
# Verified on the live site: /api/lib/PHPMailer.php returned 200, publicly
# advertising the exact PHPMailer version to anyone scanning for known CVEs.
# The library must be readable by PHP via require_once but never over HTTP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/lib/ - [F,L]
</IfModule>

# --- Raster image caching ---------------------------------------------------
# The earlier ExpiresByType block listed webp, avif and svg but omitted jpeg,
# png and ico, so those fell through to a 7-day host default.
<IfModule mod_expires.c>
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
