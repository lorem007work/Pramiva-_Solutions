# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# cPanel SMTP credentials — the live file belongs outside public_html.
pramiva-mail-config.php

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Deployment archives — built artefacts, never committed
/deploy/

# Browser automation artefacts
/.playwright-mcp/

# Image working files — originals and intermediates kept locally, not in the
# repo. Only the compressed assets under public/images/ are committed.
/groupphoto.png
/pramiva-team-assets/
/pramiva-team-section-standalone.html
*.png
# ...but shipped assets under public/images/ ARE deliverables. Without this the
# hero mark is absent from a fresh clone and the fold renders a broken image.
!public/images/**/*.png

# Design references — kept locally, never deployed.
/design-refs/

# Deployment bundles, rebuilt from out/ each release.
/pramiva-site-*.zip
/pramiva-deploy.zip
/deploy/

# Local review scratch (raw photo exports, not deliverables)
tmp/

# Local working documents and runbooks. DEPLOY.md names server paths and the
# other sites on that cPanel account; this repo is public.
/DEPLOY.md
/AGENTS.md
/documntation.md
/Nepal Pramiva Solutions.md
