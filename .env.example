# Copy to .env.local and fill in.
#
# NOTE: this is a STATIC EXPORT. Anything in this file reaches the browser in
# plain text. Never put a secret here. SMTP credentials live in a PHP config
# OUTSIDE public_html on the server. See docs/ARCHITECTURE.md section 6.

# Read at BUILD time and baked into canonical URLs, the sitemap and OG tags.
# Set it correctly before the production build or the site ships wrong URLs.
# https, not http - .htaccess forces HTTPS and AutoSSL provides the cert.
NEXT_PUBLIC_SITE_URL=https://pramivasolutions.com.np
